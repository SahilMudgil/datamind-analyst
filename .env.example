# =================================================================
# AGENTIC TEXT-TO-SQL ANALYST - ENVIRONMENT CONFIGURATION
# =================================================================

# --- LLM API Keys ---
# Gemini API Key (Tool-calling, SQL Generation, Schema Linking Embeddings)
GEMINI_API_KEY=your_gemini_api_key_here

# Groq API Key (Llama 3.x for fast Intent Check & Result Explanation)
GROQ_API_KEY=your_groq_api_key_here

# Embedding Model
EMBEDDING_MODEL=text-embedding-004

# --- Application Database (PostgreSQL + pgvector) ---
# When running via Docker Compose, host is 'app_db' on port 5432.
# When accessing from Windows host, port is mapped to 5433 (to avoid conflict with local port 5432).
DATABASE_URL=postgresql://app_user:app_password@localhost:5433/app_db

# --- Target Database (Sandboxed Demo DB for agent to query) ---
# Uses dedicated read-only role 'readonly_agent'
TARGET_DB_URL=postgresql://readonly_agent:readonly_secure_pass@localhost:5433/ecommerce_db

# --- Security & JWT Authentication ---
JWT_SECRET_KEY=change_this_to_a_very_secure_random_32_character_secret_key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- Server & CORS Settings ---
BACKEND_PORT=8000
FRONTEND_PORT=3000
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Query Execution Safety Guardrails
QUERY_TIMEOUT_SECONDS=10
MAX_QUERY_RETRIES=2
DEFAULT_ROW_LIMIT=100
